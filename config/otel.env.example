# Optional quantitative telemetry via Claude Code's native OpenTelemetry support.
# Source this file (or add to your shell profile) before starting Claude Code.
# It complements the hook-based trace with per-request metrics: tokens, cost,
# latency, model, without any custom code.

export CLAUDE_CODE_ENABLE_TELEMETRY=1

# Simplest local setup: write metrics/events to the console or an OTLP collector.
# For research use, an easy stack is the OpenTelemetry Collector with a file
# exporter, or Grafana + Prometheus if you want dashboards.
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# For quick experiments without a collector, use console exporters instead:
# export OTEL_METRICS_EXPORTER=console
# export OTEL_LOGS_EXPORTER=console

# See: https://code.claude.com/docs/en/monitoring-usage
