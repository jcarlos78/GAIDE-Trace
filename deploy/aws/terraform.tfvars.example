# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored: it names
# your infrastructure, and tfvars files are where secrets end up by accident.

domain     = "trace.example.com"
aws_region = "us-east-1"

# Uncomment to let Terraform create the A record instead of doing it by hand.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Session Manager covers shell access; only open 22 if you actually need it,
# and only to your own address.
# ssh_allowed_cidrs = ["203.0.113.4/32"]

# Pin a release for anything you depend on.
# repo_ref = "v0.3.1"

# instance_type    = "t4g.small"
# data_volume_size = 20
